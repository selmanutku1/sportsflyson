rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. GLOBAL SAFETY NET (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Startup connection check document
    match /test/connection {
      allow get: if isSignedIn();
    }

    // 2. HARDENED AUTHENTICATION & ROLE PRIMITIVES
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isNonAnonymousUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'anonymous'
      );
    }

    // SÜPER ADMİN (Bootstrapped verified email or trusted /admins/{uid} doc)
    function isAdmin() {
      return isNonAnonymousUser() && (
        (request.auth.token.email == 'selmanutkumarmara@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Kullanıcı Rol Çözümleyicisi (/users/{uid})
    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return hasUserDoc() ? userDoc().role : '';
    }

    function getUserTrainerId() {
      return hasUserDoc() && ('trainerId' in userDoc()) ? userDoc().trainerId : '';
    }

    // KULÜP YÖNETİCİSİ
    function isClubManager() {
      return isNonAnonymousUser() && getUserRole() == 'kulup_yoneticisi';
    }

    // ANTRENÖR (EĞİTMEN)
    function isTrainer() {
      return isNonAnonymousUser() && getUserRole() == 'egitmen';
    }

    function isClubStaff() {
      return isAdmin() || isClubManager() || isTrainer();
    }

    function isAssignedTrainerId(trainerRefId) {
      return isTrainer() && (
        trainerRefId == request.auth.uid ||
        (getUserTrainerId() != '' && trainerRefId == getUserTrainerId())
      );
    }

    // VELİ / SPORCU KVKK İZOLASYONU (Yalnızca kendi bağlı olduğu kayıtlar)
    function isParentOrSelfRecord(data) {
      return isSignedIn() && (
        ('ownerId' in data && data.ownerId == request.auth.uid) ||
        ('parentUid' in data && data.parentUid == request.auth.uid) ||
        (isVerifiedEmail() && (
          ('veliEposta' in data && data.veliEposta == request.auth.token.email) ||
          ('parentEmail' in data && data.parentEmail == request.auth.token.email) ||
          ('email' in data && data.email == request.auth.token.email)
        ))
      );
    }

    // 3. VALIDATION BLUEPRINTS (Anti-Update-Gap & Strict Schema Enforcement)
    function isValidUserPublicProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'clubName', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'clubName', 'role', 'trainerId', 'clubOwnerId', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100 &&
        data.clubName is string && data.clubName.size() >= 2 && data.clubName.size() <= 140 &&
        data.role is string && data.role in ['kulup_yoneticisi', 'egitmen', 'veli', 'sporcu'] &&
        (!('trainerId' in data) || isValidId(data.trainerId)) &&
        (!('clubOwnerId' in data) || isValidId(data.clubOwnerId)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivatePII(data) {
      return data.keys().hasAll(['ownerId', 'email', 'phone', 'kvkkConsentAccepted', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'email', 'phone', 'maskedTcKimlik', 'kvkkConsentAccepted', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.email is string && data.email.size() <= 160 &&
        data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 32 &&
        (!('maskedTcKimlik' in data) || (data.maskedTcKimlik is string && data.maskedTcKimlik.size() <= 20)) &&
        data.kvkkConsentAccepted is bool && data.kvkkConsentAccepted == true &&
        data.updatedAt is timestamp;
    }

    function isValidSporcu(data) {
      return data.keys().hasAll(['id', 'ownerId', 'code', 'name', 'email', 'facility', 'branch', 'groupId', 'trainerId', 'isActive', 'registrationDate', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'code', 'name', 'email', 'phone', 'birthDate', 'facility', 'branch', 'groupId', 'teamGroup', 'trainerId', 'trainerName', 'isActive', 'avatarUrl', 'registrationDate', 'parentUid', 'veliEposta', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        isValidId(data.code) && data.code.size() >= 4 && data.code.size() <= 32 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 160 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 32)) &&
        (!('birthDate' in data) || (data.birthDate is string && data.birthDate.size() >= 4 && data.birthDate.size() <= 24)) &&
        data.facility is string && data.facility.size() >= 2 && data.facility.size() <= 140 &&
        data.branch is string && data.branch.size() >= 2 && data.branch.size() <= 80 &&
        isValidId(data.groupId) &&
        (!('teamGroup' in data) || (data.teamGroup is string && data.teamGroup.size() <= 120)) &&
        isValidId(data.trainerId) &&
        (!('trainerName' in data) || (data.trainerName is string && data.trainerName.size() <= 120)) &&
        data.isActive is bool &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
        data.registrationDate is string && data.registrationDate.size() >= 4 && data.registrationDate.size() <= 32 &&
        (!('parentUid' in data) || isValidId(data.parentUid)) &&
        (!('veliEposta' in data) || (data.veliEposta is string && data.veliEposta.size() <= 160)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEgitmen(data) {
      return data.keys().hasAll(['id', 'ownerId', 'code', 'name', 'email', 'phone', 'facility', 'branch', 'assignedGroupIds', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'code', 'name', 'email', 'phone', 'facility', 'branch',
          'assignedGroupIds', 'assignedGroups', 'title', 'licenseLevel', 'status',
          'experienceYears', 'rating', 'activeGroupsCount', 'activeAthletesCount',
          'weeklyHours', 'hourlyRate', 'monthlySalary', 'city', 'avatarUrl',
          'bio', 'gender', 'address', 'accountDuration', 'mailEnabled', 'smsEnabled',
          'specialties', 'joinDate', 'reviewCount', 'documents', 'appointments',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        isValidId(data.code) && data.code.size() >= 4 && data.code.size() <= 32 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 160 &&
        data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 32 &&
        data.facility is string && data.facility.size() >= 2 && data.facility.size() <= 140 &&
        data.branch is string && data.branch.size() >= 2 && data.branch.size() <= 80 &&
        data.assignedGroupIds is list && data.assignedGroupIds.size() <= 20 &&
        (data.assignedGroupIds.size() == 0 || data.assignedGroupIds[0] is string) &&
        (!('assignedGroups' in data) || (data.assignedGroups is list && data.assignedGroups.size() <= 20 && (data.assignedGroups.size() == 0 || data.assignedGroups[0] is string))) &&
        (!('title' in data) || (data.title is string && data.title.size() <= 140)) &&
        (!('licenseLevel' in data) || (data.licenseLevel is string && data.licenseLevel.size() <= 140)) &&
        data.status is string && data.status in ['Aktif', 'İzinli', 'Ayrıldı'] &&
        (!('experienceYears' in data) || (data.experienceYears is number && data.experienceYears >= 0)) &&
        (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5)) &&
        (!('activeGroupsCount' in data) || (data.activeGroupsCount is number && data.activeGroupsCount >= 0)) &&
        (!('activeAthletesCount' in data) || (data.activeAthletesCount is number && data.activeAthletesCount >= 0)) &&
        (!('weeklyHours' in data) || (data.weeklyHours is number && data.weeklyHours >= 0)) &&
        (!('hourlyRate' in data) || (data.hourlyRate is number && data.hourlyRate >= 0)) &&
        (!('monthlySalary' in data) || (data.monthlySalary is number && data.monthlySalary >= 0)) &&
        (!('city' in data) || (data.city is string && data.city.size() <= 80)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000)) &&
        (!('gender' in data) || (data.gender is string && data.gender.size() <= 32)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
        (!('accountDuration' in data) || (data.accountDuration is string && data.accountDuration.size() <= 64)) &&
        (!('mailEnabled' in data) || data.mailEnabled is bool) &&
        (!('smsEnabled' in data) || data.smsEnabled is bool) &&
        (!('specialties' in data) || (data.specialties is list && data.specialties.size() <= 20 && (data.specialties.size() == 0 || data.specialties[0] is string))) &&
        (!('joinDate' in data) || (data.joinDate is string && data.joinDate.size() <= 32)) &&
        (!('reviewCount' in data) || (data.reviewCount is number && data.reviewCount >= 0)) &&
        (!('documents' in data) || (data.documents is list && data.documents.size() <= 50 && (data.documents.size() == 0 || data.documents[0] is map))) &&
        (!('appointments' in data) || (data.appointments is list && data.appointments.size() <= 50 && (data.appointments.size() == 0 || data.appointments[0] is map))) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGrup(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'instructorId', 'instructorName', 'facility', 'branch', 'memberCount', 'maxCapacity', 'monthlyFee', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'name', 'instructorId', 'instructorName', 'primaryAthleteIds', 'facility', 'branch', 'category', 'ageGroup', 'memberCount', 'maxCapacity', 'monthlyFee', 'status', 'scheduleDays', 'scheduleTime', 'scheduleLocation', 'description', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 140 &&
        isValidId(data.instructorId) &&
        data.instructorName is string && data.instructorName.size() >= 2 && data.instructorName.size() <= 120 &&
        (!('primaryAthleteIds' in data) || (data.primaryAthleteIds is list && data.primaryAthleteIds.size() <= 200 && (data.primaryAthleteIds.size() == 0 || data.primaryAthleteIds[0] is string))) &&
        data.facility is string && data.facility.size() >= 2 && data.facility.size() <= 140 &&
        data.branch is string && data.branch.size() >= 2 && data.branch.size() <= 80 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 80)) &&
        (!('ageGroup' in data) || (data.ageGroup is string && data.ageGroup.size() <= 64)) &&
        data.memberCount is number && data.memberCount >= 0 &&
        data.maxCapacity is number && data.maxCapacity >= 1 &&
        data.monthlyFee is number && data.monthlyFee >= 0 &&
        data.status is string && data.status in ['Aktif', 'Dolu', 'Askıda'] &&
        (!('scheduleDays' in data) || (data.scheduleDays is list && data.scheduleDays.size() <= 14 && (data.scheduleDays.size() == 0 || data.scheduleDays[0] is string))) &&
        (!('scheduleTime' in data) || (data.scheduleTime is string && data.scheduleTime.size() <= 64)) &&
        (!('scheduleLocation' in data) || (data.scheduleLocation is string && data.scheduleLocation.size() <= 140)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 600)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGrupUyesi(data) {
      return data.keys().hasAll(['id', 'grupId', 'sporcuId', 'instructorId', 'ownerId', 'name', 'code', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'grupId', 'sporcuId', 'instructorId', 'ownerId', 'name', 'code', 'phone', 'birthYear', 'parentName', 'parentPhone', 'attendanceRate', 'licenseNumber', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.grupId) &&
        isValidId(data.sporcuId) &&
        isValidId(data.instructorId) &&
        isValidId(data.ownerId) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        isValidId(data.code) && data.code.size() >= 4 && data.code.size() <= 32 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
        (!('birthYear' in data) || (data.birthYear is number && data.birthYear >= 1950 && data.birthYear <= 2035)) &&
        (!('parentName' in data) || (data.parentName is string && data.parentName.size() <= 120)) &&
        (!('parentPhone' in data) || (data.parentPhone is string && data.parentPhone.size() <= 32)) &&
        (!('attendanceRate' in data) || (data.attendanceRate is number && data.attendanceRate >= 0 && data.attendanceRate <= 100)) &&
        (!('licenseNumber' in data) || (data.licenseNumber is string && data.licenseNumber.size() <= 64)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidYoklamaKaydi(data) {
      return data.keys().hasAll(['id', 'ownerId', 'groupId', 'groupName', 'date', 'records', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'groupId', 'groupName', 'date', 'records', 'presentCount', 'absentCount', 'excusedCount', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        isValidId(data.groupId) &&
        data.groupName is string && data.groupName.size() >= 1 && data.groupName.size() <= 160 &&
        data.date is string && data.date.size() >= 4 && data.date.size() <= 32 &&
        data.records is list && data.records.size() <= 150 &&
        (data.records.size() == 0 || data.records[0] is map) &&
        (!('presentCount' in data) || (data.presentCount is number && data.presentCount >= 0)) &&
        (!('absentCount' in data) || (data.absentCount is number && data.absentCount >= 0)) &&
        (!('excusedCount' in data) || (data.excusedCount is number && data.excusedCount >= 0)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMuhasebeHareket(data) {
      return data.keys().hasAll(['id', 'ownerId', 'type', 'title', 'category', 'amount', 'date', 'payerOrPayee', 'paymentMethod', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'type', 'title', 'category', 'amount', 'date', 'payerOrPayee', 'paymentMethod', 'status', 'description', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.type is string && data.type in ['Gelir', 'Gider'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 120 &&
        data.amount is number && data.amount >= 0 &&
        data.date is string && data.date.size() >= 4 && data.date.size() <= 32 &&
        data.payerOrPayee is string && data.payerOrPayee.size() >= 1 && data.payerOrPayee.size() <= 160 &&
        data.paymentMethod is string && data.paymentMethod in ['Nakit', 'Kredi Kartı', 'Havale/EFT', 'POS'] &&
        data.status is string && data.status in ['Tamamlandı', 'Beklemede', 'İptal'] &&
        (!('description' in data) || (data.description is string && data.description.size() <= 600)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMuhasebeKategori(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'type', 'itemCount', 'totalAmount', 'color', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'name', 'type', 'itemCount', 'totalAmount', 'color', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.type is string && data.type in ['Gelir', 'Gider'] &&
        data.itemCount is number && data.itemCount >= 0 &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.color is string && data.color.size() >= 1 && data.color.size() <= 32 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOdemePlani(data) {
      return data.keys().hasAll(['id', 'ownerId', 'athleteName', 'athleteCode', 'planName', 'installment', 'dueDate', 'amount', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'athleteName', 'athleteCode', 'planName', 'installment', 'dueDate', 'amount', 'status', 'paidDate', 'receiptNumber', 'receiptDate', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.athleteName is string && data.athleteName.size() >= 1 && data.athleteName.size() <= 140 &&
        data.athleteCode is string && data.athleteCode.size() >= 1 && data.athleteCode.size() <= 32 &&
        data.planName is string && data.planName.size() >= 1 && data.planName.size() <= 160 &&
        data.installment is string && data.installment.size() >= 1 && data.installment.size() <= 32 &&
        data.dueDate is string && data.dueDate.size() >= 4 && data.dueDate.size() <= 32 &&
        data.amount is number && data.amount >= 0 &&
        data.status is string && data.status in ['Ödendi', 'Bekliyor', 'Gecikti'] &&
        (!('paidDate' in data) || (data.paidDate is string && data.paidDate.size() <= 32)) &&
        (!('receiptNumber' in data) || (data.receiptNumber is string && data.receiptNumber.size() <= 32)) &&
        (!('receiptDate' in data) || (data.receiptDate is string && data.receiptDate.size() <= 32)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAntrenmanSeansi(data) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'branch', 'date', 'startTime', 'endTime', 'trainerName', 'facilityName', 'capacity', 'enrolledCount', 'status', 'color', 'attendees', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'title', 'branch', 'groupName', 'sube', 'date', 'startTime', 'endTime', 'trainerName', 'facilityName', 'capacity', 'enrolledCount', 'status', 'color', 'notes', 'attendees', 'googleCalendarEventId', 'googleCalendarLink', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 180 &&
        data.branch is string && data.branch.size() >= 1 && data.branch.size() <= 80 &&
        (!('groupName' in data) || (data.groupName is string && data.groupName.size() <= 140)) &&
        (!('sube' in data) || (data.sube is string && data.sube.size() <= 140)) &&
        data.date is string && data.date.size() >= 4 && data.date.size() <= 32 &&
        data.startTime is string && data.startTime.size() >= 3 && data.startTime.size() <= 16 &&
        data.endTime is string && data.endTime.size() >= 3 && data.endTime.size() <= 16 &&
        data.trainerName is string && data.trainerName.size() >= 1 && data.trainerName.size() <= 120 &&
        data.facilityName is string && data.facilityName.size() >= 1 && data.facilityName.size() <= 160 &&
        data.capacity is number && data.capacity >= 1 &&
        data.enrolledCount is number && data.enrolledCount >= 0 &&
        data.status is string && data.status in ['Planlandı', 'Devam Ediyor', 'Tamamlandı', 'İptal'] &&
        data.color is string && data.color in ['blue', 'emerald', 'amber', 'purple', 'rose', 'indigo', 'sky'] &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 800)) &&
        data.attendees is list && data.attendees.size() <= 100 &&
        (data.attendees.size() == 0 || data.attendees[0] is map) &&
        (!('googleCalendarEventId' in data) || (data.googleCalendarEventId is string && data.googleCalendarEventId.size() <= 160)) &&
        (!('googleCalendarLink' in data) || (data.googleCalendarLink is string && data.googleCalendarLink.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAnket(data) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'description', 'targetAudience', 'status', 'responseCount', 'totalSent', 'createdDate', 'dueDate', 'questions', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'title', 'description', 'targetAudience', 'status', 'responseCount', 'totalSent', 'createdDate', 'dueDate', 'questions', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.description is string && data.description.size() <= 800 &&
        data.targetAudience is string && data.targetAudience in ['Sporcu', 'Veli', 'Eğitmen', 'Genel'] &&
        data.status is string && data.status in ['Aktif', 'Taslak', 'Tamamlandı'] &&
        data.responseCount is number && data.responseCount >= 0 &&
        data.totalSent is number && data.totalSent >= 0 &&
        data.createdDate is string && data.createdDate.size() >= 4 && data.createdDate.size() <= 32 &&
        data.dueDate is string && data.dueDate.size() >= 4 && data.dueDate.size() <= 32 &&
        data.questions is list && data.questions.size() <= 30 &&
        (data.questions.size() == 0 || data.questions[0] is map) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDestekTalebi(data) {
      return data.keys().hasAll(['id', 'ownerId', 'ticketNumber', 'subject', 'category', 'priority', 'status', 'clubName', 'clubPackage', 'creatorName', 'creatorEmail', 'creatorPhone', 'createdDateStr', 'updatedDateStr', 'preferredContact', 'messages', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'ticketNumber', 'subject', 'category', 'priority', 'status', 'clubName', 'clubPackage', 'clubBranch', 'creatorName', 'creatorEmail', 'creatorPhone', 'createdDateStr', 'updatedDateStr', 'closedAt', 'preferredContact', 'messages', 'assignedAgent', 'feedback', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        data.ticketNumber is number && data.ticketNumber >= 0 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 240 &&
        data.category is string && data.category in ['teknik', 'muhasebe', 'paket', 'egitim-planlama', 'veli-karne', 'entegrasyon', 'oneri'] &&
        data.priority is string && data.priority in ['Dusuk', 'Normal', 'Yuksek', 'Acil'] &&
        data.status is string && data.status in ['Acik', 'Yanitlandi', 'MusteriYaniti', 'Beklemede', 'Cozuldu', 'Kapali'] &&
        data.clubName is string && data.clubName.size() <= 160 &&
        data.clubPackage is string && data.clubPackage.size() <= 100 &&
        (!('clubBranch' in data) || (data.clubBranch is string && data.clubBranch.size() <= 140)) &&
        data.creatorName is string && data.creatorName.size() <= 140 &&
        data.creatorEmail is string && data.creatorEmail.size() <= 160 &&
        data.creatorPhone is string && data.creatorPhone.size() <= 32 &&
        data.createdDateStr is string && data.createdDateStr.size() <= 64 &&
        data.updatedDateStr is string && data.updatedDateStr.size() <= 64 &&
        (!('closedAt' in data) || (data.closedAt is string && data.closedAt.size() <= 64)) &&
        data.preferredContact is string && data.preferredContact in ['panel', 'whatsapp', 'email', 'phone'] &&
        data.messages is list && data.messages.size() <= 100 &&
