        "signedAt": { "type": "string", "maxLength": 64 },
        "contracts": { "type": "array" },
        "signature": { "type": "string", "maxLength": 200 },
        "isDemo": { "type": "boolean" }
      },
      "required": ["id", "userId", "email", "clubName", "managerName", "signedAt", "contracts", "signature"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Restricted admin-only system configuration documents (such as SMTP email settings).",
      "type": "object",
      "properties": {
        "host": { "type": "string", "maxLength": 160 },
        "port": { "type": "number" },
        "secure": { "type": "boolean" },
        "user": { "type": "string", "maxLength": 160 },
        "fromName": { "type": "string", "maxLength": 140 },
        "fromEmail": { "type": "string", "maxLength": 160 }
      }
    },
    "ClubWebsite": {
      "title": "ClubWebsite",
      "description": "Public club landing page configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subdomain": { "type": "string", "maxLength": 100 },
        "siteTitle": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "subdomain", "siteTitle"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public user profile isolated from PII."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivatePII" },
      "description": "Strict KVKK PII subcollection accessible only by the owner or verified admin."
    },
    "/sporcular/{sporcuId}": {
      "schema": { "$ref": "#/entities/Sporcu" },
      "description": "Club athletes collection."
    },
    "/egitmenler/{egitmenId}": {
      "schema": { "$ref": "#/entities/Egitmen" },
      "description": "Club trainers collection."
    },
    "/gruplar/{grupId}": {
      "schema": { "$ref": "#/entities/Grup" },
      "description": "Training groups collection."
    },
    "/gruplar/{grupId}/uyeler/{uyeId}": {
      "schema": { "$ref": "#/entities/GrupUyesi" },
      "description": "Subcollection of enrolled athletes per training group."
    },
    "/spor-okulu-basvurulari/{basvuruId}": {
      "schema": { "$ref": "#/entities/SporOkuluBasvurusu" },
      "description": "Public applications for sports school registration."
    },
    "/labReports/{reportId}": {
      "schema": { "$ref": "#/entities/AthleteLabReport" },
      "description": "SportsFly Lab biometric and motor performance reports."
    },
    "/karneler/{karneId}": {
      "schema": { "$ref": "#/entities/Karne" },
      "description": "Athlete 5-page scorecards."
    },
    "/paymentIntents/{intentId}": {
      "schema": { "$ref": "#/entities/PaymentIntent" },
      "description": "PCI-DSS SAQ-A tokenized payment intents."
    },
    "/googleUsers/{userId}": {
      "schema": { "$ref": "#/entities/GoogleUserAccessRecord" },
      "description": "Google login users and their active module permissions managed by Admin."
    },
    "/registered_users/{userId}": {
      "schema": { "$ref": "#/entities/RegisteredUser" },
      "description": "Registered email accounts with approval lifecycle stored persistently in Firestore."
    },
    "/uploadedFiles/{fileId}": {
      "schema": { "$ref": "#/entities/UploadedFile" },
      "description": "Uploaded athlete Excel files."
    },
    "/company_profile/{docId}": {
      "schema": { "$ref": "#/entities/CompanyProfile" },
      "description": "Company profile and branding settings for analysis firm and sports schools."
    },
    "/labArchives/{archiveId}": {
      "schema": { "$ref": "#/entities/LabArchive" },
      "description": "SportsFly Lab archived report cards indexed by creation calendar date and sports school name."
    },
    "/sozlesme_onaylari/{approvalId}": {
      "schema": { "$ref": "#/entities/SozlesmeOnayi" },
      "description": "Contract and KVKK acceptance records."
    },
    "/system_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSetting" },
      "description": "Admin-only SMTP and system configuration."
    },
    "/club_websites/{websiteId}": {
      "schema": { "$ref": "#/entities/ClubWebsite" },
      "description": "Club public landing page settings."
    }
  }
