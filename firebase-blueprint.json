        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["reportId", "ownerId", "athleteCode", "athleteName", "sportBranch", "overallScore", "createdAt", "updatedAt"]
    },
    "PaymentIntent": {
      "title": "PaymentIntent",
      "description": "PCI-DSS SAQ-A tokenized payment intent record. Never stores raw PAN or CVV.",
      "type": "object",
      "properties": {
        "intentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "planId": {
          "type": "string",
          "enum": ["baslangic-kulubu", "kulup-akademi", "pro-akademi-coklu-sube"]
        },
        "billingCycle": {
          "type": "string",
          "enum": ["aylik", "yillik"]
        },
        "amountTry": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["TRY"]
        },
        "status": {
          "type": "string",
          "enum": ["requires_3ds_authorization", "succeeded", "cancelled", "refunded"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["intentId", "ownerId", "idempotencyKey", "planId", "billingCycle", "amountTry", "currency", "status", "createdAt", "updatedAt"]
    },
    "GoogleUserAccessRecord": {
      "title": "GoogleUserAccessRecord",
      "description": "Google OAuth login users and their Admin-configured active system areas.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "clubName": { "type": "string" },
        "phone": { "type": "string" },
        "assignedPlan": { "type": "string" },
        "allowedPages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "isFullAccess": { "type": "boolean" },
        "firstLoginAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "name", "email", "allowedPages", "isFullAccess"]
    },
    "RegisteredUser": {
      "title": "RegisteredUser",
      "description": "User account registered via Email and Password, requiring Admin approval for active access.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "password": { "type": "string" },
        "clubName": { "type": "string", "maxLength": 140 },
        "managerName": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 32 },
        "city": { "type": "string" },
        "district": { "type": "string" },
        "branches": { "type": "array", "items": { "type": "string" } },
        "role": { "type": "string" },
        "status": { "type": "string", "enum": ["onay_bekliyor", "onaylandi", "reddedildi"] },
        "selectedPlan": { "type": "string" },
        "createdAt": { "type": "string" },
        "approvedAt": { "type": "string" },
        "approvedBy": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "authProvider": { "type": "string" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "clubName", "managerName", "phone", "role", "status", "createdAt"]
    },
    "CompanyProfile": {
      "title": "CompanyProfile",
      "description": "Company and sports school profile metadata and branding.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "clubName": { "type": "string" },
        "branchName": { "type": "string" },
        "authorizedPerson": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "city": { "type": "string" },
        "logoDataUrl": { "type": "string" },
        "companyType": { "type": "string" },
        "accessCode": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "companyName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public user profile isolated from PII."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivatePII" },
      "description": "Strict KVKK PII subcollection accessible only by the owner or verified admin."
    },
    "/sporcular/{sporcuId}": {
      "schema": { "$ref": "#/entities/Sporcu" },
      "description": "Club athletes collection."
    },
    "/egitmenler/{egitmenId}": {
      "schema": { "$ref": "#/entities/Egitmen" },
      "description": "Club trainers collection."
    },
    "/gruplar/{grupId}": {
      "schema": { "$ref": "#/entities/Grup" },
      "description": "Training groups collection."
    },
    "/gruplar/{grupId}/uyeler/{uyeId}": {
      "schema": { "$ref": "#/entities/GrupUyesi" },
      "description": "Subcollection of enrolled athletes per training group."
    },
    "/spor-okulu-basvurulari/{basvuruId}": {
      "schema": { "$ref": "#/entities/SporOkuluBasvurusu" },
      "description": "Public applications for sports school registration."
    },
    "/labReports/{reportId}": {
      "schema": { "$ref": "#/entities/AthleteLabReport" },
      "description": "SportsFly Lab biometric and motor performance reports."
    },
    "/paymentIntents/{intentId}": {
      "schema": { "$ref": "#/entities/PaymentIntent" },
      "description": "PCI-DSS SAQ-A tokenized payment intents."
    },
    "/googleUsers/{userId}": {
      "schema": { "$ref": "#/entities/GoogleUserAccessRecord" },
      "description": "Google login users and their active module permissions managed by Admin."
    },
    "/registered_users/{userId}": {
      "schema": { "$ref": "#/entities/RegisteredUser" },
      "description": "Registered email accounts with approval lifecycle stored persistently in Firestore."
    },
    "/company_profile/{docId}": {
      "schema": { "$ref": "#/entities/CompanyProfile" },
      "description": "Company profile and branding settings for analysis firm and sports schools."
    }
  }
}
